#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

STATE="${HOME}/.vibecode"
BIN="$STATE/bin"
ROOT="${VIBECODE_ROOT:-$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
export VIBECODE_ROOT="$ROOT"

usage(){ cat <<'EOF'
tv — Termux VibeCode control plane

  tv status
  tv doctor
  tv self-test
  tv tune [detect|apply]
  tv shell
  tv workspace <name>
  tv services [status|start|stop|restart|supervise] [name]
  tv ai <prompt>
  tv version
EOF
}
py(){ exec python3 "$STATE/tvd.py" "$@"; }

self_test(){
  local failed=0
  printf '%s\n' 'VibeCode self-test'
  for cmd in tv tune tv-ai; do
    if [[ -x "$BIN/$cmd" ]]; then
      printf 'check.%s=PASS\n' "$cmd"
    else
      printf 'check.%s=FAIL\n' "$cmd"
      failed=1
    fi
  done
  if [[ -x "$BIN/vsh" ]]; then
    printf 'check.vsh=PASS\n'
    if ! printf 'echo self-test-ok\n' | "$BIN/vsh" | grep -Fqx 'self-test-ok'; then
      printf '%s\n' 'check.vsh_exec=FAIL'
      failed=1
    else
      printf '%s\n' 'check.vsh_exec=PASS'
    fi
  else
    printf '%s\n' 'check.vsh=FAIL'
    failed=1
  fi
  if [[ -f "$STATE/.install-marker" && -f "$STATE/version" ]]; then
    printf '%s\n' 'check.install_state=PASS'
  else
    printf '%s\n' 'check.install_state=FAIL'
    failed=1
  fi
  if [[ -d "$STATE/workspaces" && -w "$STATE/workspaces" ]]; then
    printf '%s\n' 'check.workspace_store=PASS'
  else
    printf '%s\n' 'check.workspace_store=FAIL'
    failed=1
  fi
  if command -v python3 >/dev/null 2>&1; then
    if python3 "$STATE/tvd.py" doctor >/dev/null 2>&1; then
      printf '%s\n' 'check.doctor=PASS'
    else
      printf '%s\n' 'check.doctor=FAIL'
      failed=1
    fi
  else
    printf '%s\n' 'check.python3=FAIL'
    failed=1
  fi
  (( failed == 0 )) || return 1
  printf '%s\n' 'SELF_TEST=PASS'
}

case "${1:-}" in
  status) py status ;;
  doctor) py doctor ;;
  self-test) self_test ;;
  tune) exec "$BIN/tune" "${@:2}" ;;
  shell)
    [[ -x "$BIN/vsh" ]] || { printf '%s\n' 'vsh is not installed; run platform/install.sh first' >&2; exit 1; }
    exec "$BIN/vsh"
    ;;
  workspace)
    name="${2:-main}"
    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || { printf '%s\n' 'invalid workspace name' >&2; exit 2; }
    mkdir -p "$STATE/workspaces/$name"/{src,build,cache,tmp}
    printf '%s\n' "$STATE/workspaces/$name" ;;
  services)
    op="${2:-status}"
    case "$op" in
      status) exec python3 "$STATE/supervisor.py" status ;;
      start|stop|restart)
        [[ -n "${3:-}" ]] || { usage; exit 2; }
        exec python3 "$STATE/supervisor.py" "$op" "$3"
        ;;
      supervise) exec python3 "$STATE/supervisor.py" supervise ;;
      *) usage; exit 2 ;;
    esac
    ;;
  ai) shift; exec "$BIN/tv-ai" "$@" ;;
  version) cat "$STATE/version" 2>/dev/null || printf '%s\n' '0.1.0' ;;
  *) usage; exit 2 ;;
esac
